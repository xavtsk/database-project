# Copy to .env. The launcher and `python -m scripts.setup_databases` load it.
# Use MySQL Server; local port 3307 avoids the existing MariaDB service on 3306.
SQL_HOST=127.0.0.1
SQL_PORT=3307
SQL_USER=pokedex
SQL_PASSWORD=replace-with-your-local-password
SQL_DATABASE=pokedex_battle
# Optional socket instead of TCP (use your own local path):
# SQL_SOCKET=/tmp/mysql.sock
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=pokedex_battle
FLASK_SECRET_KEY=replace-with-a-long-random-value
PORT=5050
