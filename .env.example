# Independent setup: copy to .env and replace the placeholders.
# For the team's existing cloud databases, follow docs/submission/cloud-assessor-guide.md.
# SQL_PORT must match your MySQL service (commonly 3306); 3307 is this project's local default.
SQL_HOST=127.0.0.1
SQL_PORT=3307
SQL_USER=pokedex
SQL_PASSWORD=replace-with-your-local-password
SQL_DATABASE=pokedex_battle
# Optional socket instead of TCP (use your own local path):
# SQL_SOCKET=/tmp/mysql.sock
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=pokedex_battle
FLASK_SECRET_KEY=replace-with-a-long-random-value
PORT=5050
