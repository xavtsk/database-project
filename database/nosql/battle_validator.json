      "revision": {"bsonType": "int", "minimum": 0},
      "turn_count": {"bsonType": "int", "minimum": 0, "maximum": 200},
      "started_at": {"bsonType": "date"},
      "initial": {"bsonType": "object"},
      "player": {"bsonType": "object"},
      "opponent": {"bsonType": "object"},
      "turns": {"bsonType": "array"}
