{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["_id", "trainer_id", "difficulty", "rules_version", "revision", "status", "started_at", "turn_count", "initial", "player", "opponent", "turns"],
    "properties": {
      "_id": {"bsonType": "string"},
      "trainer_id": {"bsonType": "int"},
      "difficulty": {"enum": ["easy", "medium", "hard"]},
      "status": {"enum": ["active", "win", "loss", "draw"]},
      "revision": {"bsonType": "int", "minimum": 0},
      "turn_count": {"bsonType": "int", "minimum": 0, "maximum": 200},
      "started_at": {"bsonType": "date"},
      "initial": {"bsonType": "object"},
      "player": {"bsonType": "object"},
      "opponent": {"bsonType": "object"},
      "turns": {"bsonType": "array"},
      "budget": {
        "bsonType": "object",
        "required": ["version", "limit", "total", "costs", "remaining", "within_budget"],
        "properties": {
          "version": {"bsonType": "string"},
          "limit": {"bsonType": "int", "minimum": 1},
          "total": {"bsonType": "int", "minimum": 0},
          "costs": {"bsonType": "array", "items": {"bsonType": "int", "minimum": 1}},
          "remaining": {"bsonType": "int"},
          "within_budget": {"bsonType": "bool"}
        }
      },
      "prediction": {
        "bsonType": "object",
        "required": ["method", "label", "rules_version", "player_pressure", "opponent_pressure", "inputs", "reasons", "note", "history"],
        "properties": {
          "method": {"bsonType": "string"},
          "rules_version": {"bsonType": "string"},
          "label": {"enum": ["favoured", "evenly matched", "disadvantaged"]},
          "player_pressure": {"bsonType": "double", "minimum": 0},
          "opponent_pressure": {"bsonType": "double", "minimum": 0},
          "inputs": {"bsonType": "object"},
          "reasons": {"bsonType": "array", "items": {"bsonType": "string"}},
          "note": {"bsonType": "string"},
          "history": {"bsonType": "object"}
        }
      }
    }
  }
}
